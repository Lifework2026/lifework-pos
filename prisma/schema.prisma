// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  ADMIN
  MANAGER
  CASHIER
}

enum PaymentMethod {
  CASH
  CARD
  QR_PROMPTPAY
  BANK_TRANSFER
  OTHER
}

enum OrderStatus {
  COMPLETED
  VOIDED
  REFUNDED
}

// ============================================================
// USERS (Cashiers / Staff)
// ============================================================

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  fullName     String
  role         Role     @default(CASHIER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders      Order[]            @relation("CashierOrders")
  movements   InventoryMovement[]
  edcPayments EdcPayment[]       @relation("EdcPaymentsCreated")
}

// ============================================================
// CATALOG
// ============================================================

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  brand       String?
  isActive    Boolean  @default(true)
  categoryId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants ProductVariant[]

  @@index([categoryId])
  @@index([isActive])
}

/// One sellable unit: a specific product in a specific size and color.
/// Barcode and SKU are globally unique and each has its own B-tree index,
/// so barcode scans resolve with a single indexed lookup.
model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  size          String
  color         String
  sku           String   @unique
  barcode       String   @unique
  price         Decimal  @db.Decimal(12, 2)
  stockQuantity Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product    Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]
  movements  InventoryMovement[]

  @@unique([productId, size, color])
  @@index([productId])
  @@index([isActive])
}

// ============================================================
// SALES
// ============================================================

model Order {
  id             String        @id @default(cuid())
  receiptNo      String        @unique
  cashierId      String
  status         OrderStatus   @default(COMPLETED)
  subtotal       Decimal       @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal       @db.Decimal(12, 2)
  paymentMethod  PaymentMethod
  amountReceived Decimal?      @db.Decimal(12, 2)
  changeAmount   Decimal?      @db.Decimal(12, 2)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  cashier     User                @relation("CashierOrders", fields: [cashierId], references: [id], onDelete: Restrict)
  items       OrderItem[]
  movements   InventoryMovement[]
  edcPayment  EdcPayment?

  @@index([cashierId, createdAt])
  @@index([createdAt])
  @@index([status, createdAt])
}

/// Line items store a snapshot of product name, SKU, barcode, size, color
/// and price at the time of sale, so receipts stay correct after catalog edits.
model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  variantId      String
  productName    String
  sku            String
  barcode        String
  size           String
  color          String
  quantity       Int
  unitPrice      Decimal @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  lineTotal      Decimal @db.Decimal(12, 2)

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([variantId])
}

// ============================================================
// INVENTORY LEDGER
// ============================================================

enum MovementType {
  STOCK_IN
  ADJUSTMENT
  SALE
}

/// Append-only log of every stock change. `stockBefore + quantityChange == stockAfter`.
model InventoryMovement {
  id             String       @id @default(cuid())
  variantId      String
  type           MovementType
  quantityChange Int
  stockBefore    Int
  stockAfter     Int
  reference      String?
  note           String?
  orderId        String?
  userId         String?
  createdAt      DateTime     @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  user    User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  order   Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt])
  @@index([type, createdAt])
  @@index([orderId])
}

// ============================================================
// BANK EDC (CARD TERMINAL) PAYMENTS
// ============================================================

enum EdcMode {
  BRIDGE
  SIMULATOR
  MANUAL
}

enum EdcPaymentStatus {
  PENDING
  SUCCESS
  CANCELLED
  TIMED_OUT
  FAILED
}

/// One card payment attempt on an EDC terminal. A successful payment is linked
/// to exactly one order (`orderId` is unique), so it cannot pay two sales.
model EdcPayment {
  id                String           @id @default(cuid())
  mode              EdcMode
  status            EdcPaymentStatus @default(PENDING)
  amount            Decimal          @db.Decimal(12, 2)
  externalSessionId String?          @unique
  transactionRef    String?          @unique
  approvalCode      String?
  cardMask          String?
  failureReason     String?
  orderId           String?          @unique
  createdById       String?
  expiresAt         DateTime
  completedAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  order     Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdBy User?   @relation("EdcPaymentsCreated", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}
