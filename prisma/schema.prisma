// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  ADMIN
  MANAGER
  CASHIER
}

/// Payment channels. CARD is credit card / EDC terminal.
enum PaymentMethod {
  CASH
  CARD
  QR_PROMPTPAY
  BANK_TRANSFER
  OTHER
}

enum OrderStatus {
  COMPLETED
  PARTIALLY_REFUNDED
  REFUNDED
  VOIDED
}

enum BagType {
  NONE
  SMALL
  LARGE
}

enum PromotionKind {
  PERCENT_OFF
  AMOUNT_OFF
}

enum PromotionScope {
  ORDER
  CATEGORY
}

enum ShiftStatus {
  OPEN
  CLOSED
}

/// Why stock was changed by hand. Sales, returns and voids are explained by their receipt instead.
enum StockReason {
  DAMAGED
  LOST
  COUNT_CORRECTION
  FOUND
  OTHER
}

enum MovementType {
  STOCK_IN
  ADJUSTMENT
  SALE
  RETURN
  VOID
}

enum EdcMode {
  BRIDGE
  SIMULATOR
  MANUAL
}

enum EdcPaymentStatus {
  PENDING
  SUCCESS
  CANCELLED
  TIMED_OUT
  FAILED
}

// ============================================================
// USERS (Cashiers / Staff)
// ============================================================

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  fullName     String
  role         Role     @default(CASHIER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders      Order[]             @relation("CashierOrders")
  voidedOrders Order[]             @relation("VoidedBy")
  refunds     Refund[]
  movements   InventoryMovement[]
  edcPayments EdcPayment[]        @relation("EdcPaymentsCreated")
  auditLogs   AuditLog[]
  heldBills   HeldBill[]
  shifts         Shift[] @relation("ShiftOwner")
  closedShifts   Shift[] @relation("ShiftClosedBy")
  reviewedShifts Shift[] @relation("ShiftReviewedBy")
}

// ============================================================
// CUSTOMERS & PROMOTIONS
// ============================================================

model Member {
  id        String   @id @default(cuid())
  phone     String   @unique
  name      String
  points    Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([name])
}

model Promotion {
  id          String         @id @default(cuid())
  name        String
  code        String?        @unique
  kind        PromotionKind
  scope       PromotionScope @default(ORDER)
  /// Percent (0-100, two decimals) for PERCENT_OFF, baht for AMOUNT_OFF.
  value       Decimal        @db.Decimal(12, 2)
  categoryId  String?
  minSubtotal Decimal        @default(0) @db.Decimal(12, 2)
  startsAt    DateTime
  endsAt      DateTime
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orders   Order[]

  @@index([isActive, endsAt])
}

// ============================================================
// CATALOG
// ============================================================

/// Managed list of sizes offered in the product forms. Variants store the size as text,
/// so history stays intact if a size is later renamed or removed from this list.
model Size {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([sortOrder])
}

/// A cart parked at the till so the cashier can serve someone else, then resumed later.
/// No stock is reserved. Prices and stock are re-checked when the bill is resumed.
model HeldBill {
  id          String   @id @default(cuid())
  label       String?
  payload     Json
  itemCount   Int
  createdById String?
  createdAt   DateTime @default(now())

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

model Category {
  id        String   @id @default(cuid())
  name      String
  /// Thai display name. Falls back to `name` when empty.
  nameTh    String?
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products   Product[]
  promotions Promotion[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  /// Thai display name. Falls back to `name` when empty.
  nameTh      String?
  slug        String   @unique
  /// Public URL of the product photo in Supabase Storage.
  imageUrl    String?
  /// Object path inside the storage bucket, kept so the photo can be replaced or deleted.
  imagePath   String?
  description String?
  brand       String?
  isActive    Boolean  @default(true)
  categoryId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants ProductVariant[]

  @@index([categoryId])
  @@index([isActive])
}

/// One sellable unit: a specific product in a specific size and color.
/// Barcode and SKU are globally unique, each with its own B-tree index.
model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  size          String
  color         String
  sku           String   @unique
  barcode       String   @unique
  price         Decimal  @db.Decimal(12, 2)
  stockQuantity Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product    Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]
  movements  InventoryMovement[]

  @@unique([productId, size, color])
  @@index([productId])
  @@index([isActive])
}

// ============================================================
// SALES
// ============================================================

model Order {
  id             String      @id @default(cuid())
  receiptNo      String      @unique
  cashierId      String
  status         OrderStatus @default(COMPLETED)
  memberId       String?
  promotionId    String?
  bagType        BagType     @default(NONE)

  /// Sum of line prices before any discount (bags included).
  subtotal          Decimal @db.Decimal(12, 2)
  promotionDiscount Decimal @default(0) @db.Decimal(12, 2)
  memberDiscount    Decimal @default(0) @db.Decimal(12, 2)
  manualDiscount    Decimal @default(0) @db.Decimal(12, 2)
  pointsDiscount    Decimal @default(0) @db.Decimal(12, 2)
  /// Amount payable after all discounts.
  totalAmount       Decimal @db.Decimal(12, 2)

  pointsRedeemed Int     @default(0)
  pointsEarned   Int     @default(0)
  pointsReversed Int     @default(0)
  refundedAmount Decimal @default(0) @db.Decimal(12, 2)

  voidReason String?
  voidedAt   DateTime?
  voidedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cashier   User                @relation("CashierOrders", fields: [cashierId], references: [id], onDelete: Restrict)
  voidedBy  User?               @relation("VoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  member    Member?             @relation(fields: [memberId], references: [id], onDelete: SetNull)
  promotion Promotion?          @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  items     OrderItem[]
  payments  Payment[]
  refunds   Refund[]
  movements InventoryMovement[]

  @@index([cashierId, createdAt])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([memberId])

  /// Shift (cash drawer) the sale was rung up in.
  shiftId     String?
  /// Shift whose drawer paid the cash back when the bill was voided.
  voidShiftId String?
  shift       Shift?  @relation("ShiftSales", fields: [shiftId], references: [id], onDelete: SetNull)
  voidShift   Shift?  @relation("ShiftVoids", fields: [voidShiftId], references: [id], onDelete: SetNull)

  @@index([shiftId])
  @@index([voidShiftId])
}

/// Line items snapshot product name, SKU, barcode, size, color and price at the time of sale.
model OrderItem {
  id               String  @id @default(cuid())
  orderId          String
  variantId        String
  productName      String
  /// Thai name snapshot, so Thai receipts stay correct after catalogue edits.
  productNameTh    String?
  sku              String
  barcode          String
  size             String
  color            String
  isBag            Boolean @default(false)
  quantity         Int
  unitPrice        Decimal @db.Decimal(12, 2)
  /// unitPrice * quantity
  lineSubtotal     Decimal @db.Decimal(12, 2)
  /// Share of every order-level discount allocated to this line.
  discountAmount   Decimal @default(0) @db.Decimal(12, 2)
  /// lineSubtotal - discountAmount. Refunds are computed from this.
  netAmount        Decimal @db.Decimal(12, 2)
  refundedQuantity Int     @default(0)
  refundedAmount   Decimal @default(0) @db.Decimal(12, 2)

  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  refundItems RefundItem[]

  @@index([orderId])
  @@index([variantId])
}

/// One tender line. An order can be paid by several lines (split payment).
model Payment {
  id          String        @id @default(cuid())
  orderId     String
  method      PaymentMethod
  /// Amount applied to the order.
  amount      Decimal       @db.Decimal(12, 2)
  /// Cash handed over (CASH only). Change = tendered - amount.
  tendered    Decimal?      @db.Decimal(12, 2)
  changeGiven Decimal?      @db.Decimal(12, 2)
  /// Slip / transfer / QR reference, or the EDC transaction reference.
  reference   String?
  /// Set for card payments. Unique, so one approved terminal payment settles one line only.
  edcPaymentId String?      @unique
  /// Amount already returned to the customer through this line.
  refundedAmount Decimal    @default(0) @db.Decimal(12, 2)
  createdAt   DateTime      @default(now())

  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  edcPayment  EdcPayment?  @relation(fields: [edcPaymentId], references: [id], onDelete: SetNull)
  refundLines RefundLine[]

  @@index([orderId])
  @@index([method, createdAt])
}

/// One refund action. Money goes back through one or more RefundLine rows, one per original payment line.
model Refund {
  id          String   @id @default(cuid())
  orderId     String
  amount      Decimal  @db.Decimal(12, 2)
  reason      String
  createdById String?
  createdAt   DateTime @default(now())

  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdBy User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items     RefundItem[]
  lines     RefundLine[]

  @@index([orderId])
  @@index([createdAt])

  /// Shift whose drawer paid out any cash part of this refund.
  shiftId String?
  shift   Shift?  @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  @@index([shiftId])
}

/// Money returned through the same channel the customer paid with. Drives the channel reconciliation.
model RefundLine {
  id        String        @id @default(cuid())
  refundId  String
  paymentId String
  method    PaymentMethod
  amount    Decimal       @db.Decimal(12, 2)
  /// Transfer slip, QR or card-reversal reference for the money going back. Required for non-cash channels.
  reference String?
  createdAt DateTime      @default(now())

  refund  Refund  @relation(fields: [refundId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([refundId])
  @@index([paymentId])
  @@index([method, createdAt])
}

model RefundItem {
  id          String  @id @default(cuid())
  refundId    String
  orderItemId String
  quantity    Int
  amount      Decimal @db.Decimal(12, 2)

  refund    Refund    @relation(fields: [refundId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@index([refundId])
  @@index([orderItemId])
}

/// Append-only record of sensitive actions (voids, refunds, adjustments).
model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String
  reason     String?
  details    Json?
  userId     String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ============================================================
// INVENTORY LEDGER
// ============================================================

/// Append-only log of every stock change. `stockBefore + quantityChange == stockAfter`.
model InventoryMovement {
  id             String       @id @default(cuid())
  variantId      String
  type           MovementType
  quantityChange Int
  stockBefore    Int
  stockAfter     Int
  reference      String?
  note           String?
  orderId        String?
  userId         String?
  createdAt      DateTime     @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  user    User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  order   Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt])
  @@index([type, createdAt])
  @@index([orderId])

  /// Set for manual adjustments (damage, loss, count correction...).
  reasonCode StockReason?

  @@index([userId, createdAt])
  @@index([createdAt])
}

// ============================================================
// BANK EDC (CARD TERMINAL) PAYMENTS
// ============================================================

/// One card payment attempt on an EDC terminal. A successful payment settles at most one payment line.
model EdcPayment {
  id                String           @id @default(cuid())
  mode              EdcMode
  status            EdcPaymentStatus @default(PENDING)
  amount            Decimal          @db.Decimal(12, 2)
  externalSessionId String?          @unique
  transactionRef    String?          @unique
  approvalCode      String?
  cardMask          String?
  failureReason     String?
  createdById       String?
  expiresAt         DateTime
  completedAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  createdBy User?    @relation("EdcPaymentsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  payment   Payment?

  @@index([status, createdAt])
}

/// One cash-drawer session. A cashier declares the opening float, rings up sales, then counts the drawer at the end.
/// At most one OPEN shift per user (partial unique index in the migration).
model Shift {
  id           String      @id @default(cuid())
  userId       String
  status       ShiftStatus @default(OPEN)
  openedAt     DateTime    @default(now())
  /// Cash put in the drawer to start the shift.
  openingFloat Decimal     @db.Decimal(12, 2)
  openNote     String?

  closedAt     DateTime?
  closedById   String?
  /// Cash the system expects: float + cash sales - cash refunds - cash from voided bills.
  expectedCash Decimal?    @db.Decimal(12, 2)
  /// Cash the cashier counted and declared.
  countedCash  Decimal?    @db.Decimal(12, 2)
  /// counted - expected. Negative is short, positive is over.
  variance     Decimal?    @db.Decimal(12, 2)
  closeNote    String?
  /// Totals at close: sales by channel, refunds, voids, receipt counts.
  summary      Json?

  reviewedAt   DateTime?
  reviewedById String?
  reviewNote   String?

  user       User     @relation("ShiftOwner", fields: [userId], references: [id], onDelete: Restrict)
  closedBy   User?    @relation("ShiftClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  reviewedBy User?    @relation("ShiftReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  orders     Order[]  @relation("ShiftSales")
  voids      Order[]  @relation("ShiftVoids")
  refunds    Refund[]

  @@index([userId, status])
  @@index([openedAt])
  @@index([status, openedAt])
}
