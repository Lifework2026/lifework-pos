# Copy to .env for local work. On Vercel, add the same names under Project Settings > Environment Variables.
# Never commit real values. Run `npm run check:env` to validate.

# Supabase Postgres. Pooled connection for the app, direct connection for migrations.
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Session signing key. At least 32 random characters. Changing it signs everyone out.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# Product photo storage (Supabase Storage). Optional: without these, photo upload is disabled.
# Server-side only. The service-role key must never be exposed to the browser.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_STORAGE_BUCKET="product-images"

# Card terminal. "simulator" for demos and tests, "bridge" in production.
EDC_MODE="simulator"
# Required when EDC_MODE="bridge":
# EDC_BRIDGE_URL=""
# EDC_BRIDGE_TOKEN=""
# EDC_WEBHOOK_SECRET=""

# Used only by `npm run db:seed`. Required the first time each account is created.
# Setting one later changes that account's password.
# ADMIN_PASSWORD=""
# CASHIER_PASSWORD=""
